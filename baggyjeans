<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>AHMED BAGGY JEANS</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    color: #111;
    background: #fff;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 24px;
    border-bottom: 1px solid #eee;
    position: sticky;
    top: 0;
    background: white;
    z-index: 10;
}

.logo {
    font-size: 25px;
    font-weight: 900;
    letter-spacing: -1px;
}

.search {
    padding: 9px;
    border: 1px solid #ddd;
    width: 150px;
}

button {
    cursor: pointer;
    padding: 9px 12px;
    border: 1px solid #ddd;
    background: white;
}

.categories {
    display: flex;
    gap: 20px;
    padding: 20px;
    overflow-x: auto;
    white-space: nowrap;
}

.categories button {
    border: none;
    text-transform: uppercase;
}

.categories button:hover {
    text-decoration: underline;
}

.products {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 3px;
}

.product {
    min-width: 0;
    cursor: pointer;
}

.product-image {
    width: 100%;
    aspect-ratio: 0.68;
    background: #edf0f1;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

.product-image svg {
    width: 100%;
    height: 100%;
}

.product-info {
    padding: 10px;
}

.product-info h3 {
    font-size: 11px;
    font-weight: normal;
    text-transform: uppercase;
}

.product-info p {
    font-size: 12px;
    font-weight: bold;
}

.newsletter {
    padding: 60px 10%;
    display: grid;
    grid-template-columns: 35% 65%;
    gap: 20px;
}

.newsletter h2 {
    font-size: 25px;
}

.newsletter input {
    width: 100%;
    padding: 12px;
    border: none;
    border-bottom: 1px solid #888;
}

.signup {
    margin-top: 20px;
    padding: 12px 30px;
    background: #000;
    color: #fff;
}

footer {
    background: #000;
    color: #fff;
    padding: 40px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
}

footer a {
    color: white;
    display: block;
    margin: 10px 0;
    text-decoration: none;
}

.cart-panel {
    display: none;
    position: fixed;
    inset: 0;
    background: #0008;
    z-index: 20;
    justify-content: flex-end;
}

.cart-content {
    width: 380px;
    max-width: 90%;
    height: 100%;
    overflow-y: auto;
    background: white;
    padding: 25px;
}

@media (max-width: 900px) {
    .products {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }
}

@media (max-width: 600px) {
    header {
        padding: 14px 10px;
    }

    .logo {
        font-size: 17px;
    }

    .search {
        width: 85px;
    }

    .products {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .newsletter {
        grid-template-columns: 1fr;
        padding: 35px 7%;
    }

    footer {
        flex-direction: column;
    }
}
</style>
</head>
